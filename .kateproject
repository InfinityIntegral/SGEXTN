{
  "name": "SGEXTN",
  "files": [
    {
      "directory": ".",
      "filters": ["*"],
      "recursive": 1,
      "hidden": 1
    }
  ],
  "exclude_patterns" : [],
  "build": {
    "directory": ".",
    "targets": [
      {
        "name": "clean + configure",
        "build_cmd" : "(if exist build rmdir /s /q build) && mkdir build && cmake -S . -B build -G Ninja -DCMAKE_BUILD_TYPE=Debug"
      },
      {
        "name": "build + install",
        "build_cmd": "cmake --build build && cmake --install build --prefix build/BuildLah_install && .\\build\\BuildLah_install\\bin\\InternalTest.exe"
      },
      {
        "name": "analyse",
        "build_cmd" : "cmake --build build && cmake --install build --prefix build/BuildLah_install && .\\build\\BuildLah_install\\bin\\InternalTest.exe && patch_clangtidy.bat -verbose"
      },
      {
        "name": "debug",
        "build_cmd" : "cmake --build build && cmake --install build --prefix build/BuildLah_install && patch_lldb.bat InternalTest"
      }
    ]
  }
}
